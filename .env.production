# Releases build from this file only (committed), so anyone can rebuild the same CID.
# The CSD node the page reads and writes through (a visitor can pick another with ?node=)
NEXT_PUBLIC_CSD_API=https://csd.aon.network
# The open CSD/USDC market used for top-ups: its settlement contract on Ethereum, and AON nodes
NEXT_PUBLIC_CSD_SETTLEMENT=0x8863f0c477a30bb5a2077c813f42250d7fbefcb9
NEXT_PUBLIC_AON_NODES=https://explorer.aon.network,https://node2.aon.network,https://node3.aon.network,https://node4.aon.network
# Documents: Arweave uploads (Turbo) and the gateway they're read from
NEXT_PUBLIC_TURBO_UPLOAD=https://upload.ardrive.io
NEXT_PUBLIC_ARWEAVE_GATEWAY=https://arweave.net
